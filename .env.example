# ---------------------------------------------------------------------------
# Model provider — OPTIONAL.
#
# PathFinder runs fully without any key. The recommendation core (retrieval,
# skill-gap analysis, DAG path planning, adaptive re-ranking) is local and
# always on; a key only upgrades the language layer — free-form goal parsing,
# generated explanations and the Q&A tutor.
#
# Set EITHER of the following. If both are set, AI_PROVIDER decides.
# ---------------------------------------------------------------------------

# --- Option A: Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash

# --- Option B: Anthropic Claude ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# --- Tie-breaker ---
# Only needed when both keys are set. One of: gemini | anthropic
# AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Supabase — authentication and persistence (OPTIONAL)
#
# Without these, PathFinder runs exactly as before: no sign-in, and the learner
# profile is stored in the browser only. With them, GitHub sign-in is enabled
# and profiles + generated paths are saved to Postgres.
# ---------------------------------------------------------------------------

# Project URL and client key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection: Supabase dashboard → Project Settings → Database
# DATABASE_URL must be the *transaction pooler* (port 6543) — used at runtime.
# DIRECT_URL must be the *direct* connection (port 5432) — used for migrations,
# which cannot run through a transaction pooler.
DATABASE_URL=
DIRECT_URL=
